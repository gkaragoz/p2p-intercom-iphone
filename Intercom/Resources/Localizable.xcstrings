    "Both iPhones must use the same engine and the same pairing code. Without a code a built-in key is used; a long random code keeps others from listening in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both iPhones must use the same engine and the same pairing code. Without a code a built-in key is used; a long random code keeps others from listening in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki iPhone da aynı bağlantı motorunu ve aynı eşleştirme kodunu kullanmalı. Kod girilmezse yerleşik bir anahtar kullanılır; uzun ve rastgele bir kod başkalarının dinlemesini engeller."
          }
        }
      }
    },
